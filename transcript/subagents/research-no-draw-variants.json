                "text": "import itertools, random\nfrom functools import lru_cache\n\nEMPTY, X, O = 0, 1, 2\nLINES = ((0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6))\n\ndef has_line(b, p):\n    return any(b[a]==p and b[b_]==p and b[c]==p for a,b_,c in LINES)\n\ndraw_positions = []\nfor xs in itertools.combinations(range(9), 5):\n    b=[EMPTY]*9\n    for i in xs: b[i]=X\n    for i in range(9):\n        if b[i]==EMPTY: b[i]=O\n    b=tuple(b)\n    if not has_line(b,X) and not has_line(b,O):\n        draw_positions.append(b)\n\ndef two_stone_lines(b,p):\n    return sum(1 for a,c,d in LINES if (b[a],b[c],b[d]).count(p)==2)\n\ndef tb_last_loses(b): return O\ndef tb_last_wins(b):  return X\ndef tb_pos(b, tie):\n    nx=two_stone_lines(b,X); no=two_stone_lines(b,O)\n    return X if nx>no else O if no>nx else tie\n\nRULES = {\n  \"last mover loses\":         tb_last_loses,\n  \"last mover wins\":          tb_last_wins,\n  \"closer-to-win (O wins ties)\": lambda b: tb_pos(b,O),\n  \"closer-to-win (X wins ties)\": lambda b: tb_pos(b,X),\n}\n\ndef analyze(tb):\n    @lru_cache(maxsize=None)\n    def value(b,turn):\n        if has_line(b,X): return X\n        if has_line(b,O): return O\n        es=[i for i in range(9) if b[i]==EMPTY]\n        if not es: return tb(b)\n        nxt=O if turn==X else X\n        outs={value(tuple(list(b)[:i]+[turn]+list(b)[i+1:]),nxt) for i in es}\n        return turn if turn in outs else nxt\n    @lru_cache(maxsize=None)\n    def counts(b,turn):\n        if has_line(b,X): return (1,0)\n        if has_line(b,O): return (0,1)\n        es=[i for i in range(9) if b[i]==EMPTY]\n        if not es:\n            return (1,0) if tb(b)==X else (0,1)\n        nxt=O if turn==X else X\n        t=[0,0]\n        for i in es:\n            r=counts(tuple(list(b)[:i]+[turn]+list(b)[i+1:]),nxt)\n            t[0]+=r[0]; t[1]+=r[1]\n        return tuple(t)\n    return value((EMPTY,)*9,X), counts((EMPTY,)*9,X)\n\nprint(\"=== Perfect-play (minimax) forced win + aggregate over ALL plays ===\")\nfor name,tb in RULES.items():\n    v,c = analyze(tb)\n    print(f\"{name:38s} forced win={X if v==X else 'O'}   all-plays: X {c[0]/255168:.3f}  O {c[1]/255168:.3f}\")\n\nprint(\"\\n=== Positional tiebreak: how the 16 draw positions split ===\")\nfor tie in (X,O):\n    fx=sum(1 for b in draw_positions if tb_pos(b,tie)==X)\n    print(f\"tie->{'X' if tie==X else 'O'}: X-favored {fx} / O-favored {16-fx}\")\n\ndef sane_move(b,turn):\n    es=[i for i in range(9) if b[i]==EMPTY]\n    for i in es:\n        nb=list(b); nb[i]=turn\n        if has_line(tuple(nb),turn): return i\n    opp=O if turn==X else X\n    for i in es:\n        nb=list(b); nb[i]=opp\n        if has_line(tuple(nb),opp): return i\n    for t in (4,(0,2,6,8),(1,3,5,7)):\n        opts=[i for i in (t if isinstance(t,tuple) else (t,)) if i in es]\n        if opts: return random.choice(opts)\n    return random.choice(es)\n\ndef sim(tb, n=100000):\n    w={X:0,O:0}\n    for _ in range(n):\n        b=[EMPTY]*9; turn=X\n        while True:\n            if has_line(b,X): w[X]+=1; break\n            if has_line(b,O): w[O]+=1; break\n            es=[i for i in range(9) if b[i]==EMPTY]\n            if not es:\n                w[tb(tuple(b))]+=1; break\n            i=sane_move(tuple(b),turn); b[i]=turn\n            turn=O if turn==X else X\n    return w\n\nprint(\"\\n=== 'Sane vs sane' simulation (both use win-if-can / block-if-must / centre-corner greedy) ===\")\nrandom.seed(7)\nfor name,tb in RULES.items():\n    w=sim(tb)\n    print(f\"{name:38s} sane-vs-sane: X {w[X]/100000:.3f}  O {w[O]/100000:.3f}\")",
